# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# Database — app_user (RLS enforced) and admin/superuser (RLS bypassed)
# db:up (docker compose) exposes Postgres on 5432 with these role names.
DATABASE_URL=postgresql://app_user:app_user_password@localhost:5432/multitenant_dev
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/multitenant_dev
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# Auth
JWT_SECRET=change-this-to-a-random-64-byte-base64url-string-min-32-chars
JWT_ISSUER=multitenant-api
JWT_AUDIENCE=multitenant-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12
COOKIE_ACCESS_NAME=mt_access
COOKIE_REFRESH_NAME=mt_refresh
REFRESH_TOKEN_TTL_DAYS=30

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
